# PaperOrchestra Environment Configuration
# Copy to repository root as `.env` and fill in the providers you use.
# Leave unused keys empty. Never commit `.env` to version control.

# --- Gemini Configuration (choose ONE: Vertex AI takes precedence if both are set) ---
GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=

# --- Academic Literature Grounding (recommended to avoid Semantic Scholar 429 limits) ---
SEMANTIC_SCHOLAR_API_KEY=

# --- Optional: OpenAI Models (only if using gpt-* / o1 / o3 model names) ---
OPENAI_API_KEY=

# --- Optional: Streamlit Demo Email Notifications ---
SMTP_EMAIL=
SMTP_PASSWORD=
